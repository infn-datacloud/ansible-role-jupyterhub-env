{{ ansible_managed | comment }}
# /opt/jupyterhub/.env — compose interpolation values (0600 root).
# Contains the Grafana credentials; the Hub secrets are mounted as Docker
# secrets (see compose.yaml).
HOST_PUBLIC_IP={{ jupyterhub_public_ip }}
DNS_NAME={{ jupyterhub_dns_name }}
{# compose uses ${IAM_URL}authorize etc.: guarantee exactly one trailing slash #}
IAM_URL={{ jupyterhub_iam_url | regex_replace('/+$', '') }}/
IAM_CLIENT_ID={{ jupyterhub_iam_client_id }}
IAM_SUBJECT={{ jupyterhub_iam_subject }}
IAM_GROUPS={{ jupyterhub_iam_groups }}
IAM_ADMIN_GROUPS={{ jupyterhub_iam_admin_groups }}
JUPYTER_IMAGE_LIST={{ jupyterhub_images }}
CONTACT_EMAIL={{ jupyterhub_contact_email }}
GRAFANA_OAUTH_CLIENT_SECRET={{ _iam_client_secret_slurp.content | b64decode | trim }}
GF_ADMIN_USER={{ jupyterhub_grafana_admin_user }}
GF_ADMIN_PASSWORD={{ jupyterhub_grafana_admin_password if jupyterhub_grafana_admin_password | length > 0 else (_gf_pw_slurp.content | b64decode | trim) }}
