{{ ansible_managed | comment }}
# =============================================================================
# compose.yaml — single-node JupyterHub stack (LAB-only)
# TLS variant: {{ jupyterhub_cert_manager_type }}
#   - TLS terminated by Traefik (ACME for letsencrypt, file provider for self-signed)
#   - configurable-http-proxy in plain HTTP, internal network only
#   - secrets via Docker Compose secrets (*_FILE)
# Generated by ansible-role-jupyterhub-env: do NOT edit by hand.
# =============================================================================

# Explicit project name: keeps container/volume ownership stable even if
# jupyterhub_base_dir (and hence the directory basename) changes.
name: {{ jupyterhub_compose_project }}

secrets:
  iam_client_secret:
    file: {{ jupyterhub_secrets_dir }}/iam_client_secret
  jupyterhub_crypt_key:
    file: {{ jupyterhub_secrets_dir }}/jupyterhub_crypt_key
  jupyterhub_api_token:
    file: {{ jupyterhub_secrets_dir }}/jupyterhub_api_token
  jupyter_proxy_token:
    file: {{ jupyterhub_secrets_dir }}/jupyter_proxy_token

services:

  jupyterhub:
    image: {{ jupyterhub_hub_image }}
    container_name: jupyterhub
    depends_on: [http_proxy]
    restart: unless-stopped
    command: ["jupyterhub", "--config=/srv/jupyterhub/jupyterhub_config.py"]
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
      - {{ jupyterhub_base_dir }}/cookies:/srv/jupyterhub/cookies
      - {{ jupyterhub_base_dir }}/db:/srv/jupyterhub/db
      - {{ jupyterhub_mounts_dir }}:/jupyter-mounts
    secrets:
      - iam_client_secret
      - jupyterhub_crypt_key
      - jupyterhub_api_token
      - jupyter_proxy_token
    environment:
      - OAUTH_ENDPOINT=${IAM_URL}
      - OAUTH_CALLBACK_URL=https://${DNS_NAME}/hub/oauth_callback
      - OAUTH_GROUPS=${IAM_GROUPS}
      - ADMIN_OAUTH_GROUPS=${IAM_ADMIN_GROUPS}
      - OAUTH_SUB=${IAM_SUBJECT}
      - IAM_CLIENT_ID=${IAM_CLIENT_ID}
      - IAM_CLIENT_SECRET_FILE=/run/secrets/iam_client_secret
      - JUPYTERHUB_CRYPT_KEY_FILE=/run/secrets/jupyterhub_crypt_key
      - JUPYTERHUB_API_TOKEN_FILE=/run/secrets/jupyterhub_api_token
      - JUPYTER_PROXY_TOKEN_FILE=/run/secrets/jupyter_proxy_token
      - DNS_NAME=${DNS_NAME}
      - JUPYTER_IMAGE_LIST=${JUPYTER_IMAGE_LIST}
      - JUPYTER_RAM_LIST={{ jupyterhub_ram_list }}
      - JUPYTER_CPU_LIST={{ jupyterhub_cpu_list }}
      - DOCKER_NETWORK_NAME={{ jupyterhub_docker_network_name }}
      - WITH_GPU={{ jupyterhub_use_gpu | string | lower }}
      - JUPYTER_WITH_CVMFS={{ jupyterhub_with_cvmfs | string | lower }}
      - DEFAULT_SPAWNER={{ jupyterhub_default_spawner }}
      - JUPYTER_POST_START_CMD={{ jupyterhub_post_start_cmd }}

  # configurable-http-proxy: plain HTTP, internal network only. Ingress = Traefik.
  http_proxy:
    image: {{ jupyterhub_http_proxy_image }}
    container_name: http_proxy
    restart: unless-stopped
    secrets: [jupyter_proxy_token]
    entrypoint: /bin/sh
    command:
      - -c
      - >
        export CONFIGPROXY_AUTH_TOKEN="$$(cat /run/secrets/jupyter_proxy_token)" &&
        configurable-http-proxy
        --ip=0.0.0.0 --port=8888
        --api-ip=0.0.0.0 --api-port=8001
        --default-target=http://jupyterhub:8088
        --error-target=http://jupyterhub:8088/hub/error
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.jupyterhub.rule=Host(`${DNS_NAME}`)"
      - "traefik.http.routers.jupyterhub.entrypoints=websecure"
{% if _jupyterhub_selfsigned | bool %}
      - "traefik.http.routers.jupyterhub.tls=true"
{% else %}
      - "traefik.http.routers.jupyterhub.tls.certresolver=myhttpchallenge"
{% endif %}
      - "traefik.http.services.jupyterhub.loadbalancer.server.port=8888"

  proxy:
    image: {{ jupyterhub_traefik_image }}
    container_name: traefik
    restart: unless-stopped
    ports: ["80:80", "443:443"]
    volumes:
      - letsencrypt:/letsencrypt
      - /var/run/docker.sock:/var/run/docker.sock:ro
      - {{ jupyterhub_base_dir }}/traefik:/config
{% if _jupyterhub_selfsigned | bool %}
      - {{ jupyterhub_certs_dir }}/jupyter:/certs:ro
{% endif %}
    command:
      - "--providers.docker=true"
      - "--providers.docker.exposedbydefault=false"
      - "--providers.file.directory=/config"
      - "--providers.file.watch=true"
      - "--entrypoints.web.address=:80"
      - "--entrypoints.websecure.address=:443"
      - "--entrypoints.web.http.redirections.entryPoint.to=websecure"
{% if not _jupyterhub_selfsigned | bool %}
      - "--certificatesresolvers.myhttpchallenge.acme.httpchallenge=true"
      - "--certificatesresolvers.myhttpchallenge.acme.httpchallenge.entrypoint=web"
      - "--certificatesresolvers.myhttpchallenge.acme.email=${CONTACT_EMAIL}"
{# Per-CA storage: switching staging<->prod must never reuse the other CA's
   account/certificates (Traefik would keep serving the stored cert). #}
      - "--certificatesresolvers.myhttpchallenge.acme.storage=/letsencrypt/acme-{{ 'staging' if _jupyterhub_le_staging | bool else 'prod' }}.json"
{% if _jupyterhub_le_staging | bool %}
      - "--certificatesresolvers.myhttpchallenge.acme.caserver=https://acme-staging-v02.api.letsencrypt.org/directory"
{% endif %}
{% endif %}
{% if jupyterhub_monitoring | bool %}

  prometheus:
    image: {{ jupyterhub_prometheus_image }}
    container_name: monitoring_prometheus
    restart: unless-stopped
    depends_on: [node_exporter, cadvisor]
    volumes:
      - {{ jupyterhub_base_dir }}/prometheus/config:/etc/prometheus:ro
      - {{ jupyterhub_base_dir }}/prometheus/data:/data
    command:
      - '--config.file=/etc/prometheus/prometheus.yml'
      - '--storage.tsdb.path=/data'
      - '--storage.tsdb.retention.time={{ jupyterhub_prometheus_retention }}'
    expose: ["9090"]

  node_exporter:
    image: {{ jupyterhub_node_exporter_image }}
    container_name: monitoring_node_exporter
    restart: unless-stopped
    command:
      - '--path.rootfs=/host'
    volumes:
      - /:/host:ro,rslave
    expose: ["9100"]

  cadvisor:
    image: {{ jupyterhub_cadvisor_image }}
    container_name: monitoring_cadvisor
    privileged: true
    restart: unless-stopped
    volumes:
      - /:/rootfs:ro
      - /var/run:/var/run:rw
      - /sys:/sys:ro
      - /var/lib/docker/:/var/lib/docker:ro
      - /dev/disk/:/dev/disk:ro
    expose: ["8080"]

  grafana:
    image: {{ jupyterhub_grafana_image }}
    container_name: grafana
    restart: unless-stopped
    depends_on: [prometheus]
    expose: ["3000"]                 # always behind Traefik at /grafana, never in clear
    volumes:
      - {{ jupyterhub_base_dir }}/grafana/data:/var/lib/grafana
      - {{ jupyterhub_base_dir }}/grafana/provisioning:/etc/grafana/provisioning:ro
      - {{ jupyterhub_base_dir }}/grafana/dashboards:/var/lib/grafana/dashboards:ro
    environment:
      - GF_SERVER_ROOT_URL=https://${DNS_NAME}/grafana/
      - GF_SERVER_SERVE_FROM_SUB_PATH=true
      - GF_AUTH_OAUTH_AUTO_LOGIN=true
      - GF_AUTH_DISABLE_LOGIN_FORM=true
      - GF_AUTH_GENERIC_OAUTH_ENABLED=true
      - GF_AUTH_GENERIC_OAUTH_NAME=IAM
      - GF_AUTH_GENERIC_OAUTH_CLIENT_ID=${IAM_CLIENT_ID}
      - GF_AUTH_GENERIC_OAUTH_CLIENT_SECRET=${GRAFANA_OAUTH_CLIENT_SECRET}
      - GF_AUTH_GENERIC_OAUTH_AUTH_URL=${IAM_URL}authorize
      - GF_AUTH_GENERIC_OAUTH_TOKEN_URL=${IAM_URL}token
      - GF_AUTH_GENERIC_OAUTH_API_URL=${IAM_URL}userinfo
      - GF_AUTH_GENERIC_OAUTH_SCOPES=openid profile email
      - GF_AUTH_GENERIC_OAUTH_ALLOW_SIGN_UP=true
      - GF_USERS_ALLOW_SIGN_UP=false
      - GF_SECURITY_ADMIN_USER=${GF_ADMIN_USER:-admin}
      - GF_SECURITY_ADMIN_PASSWORD=${GF_ADMIN_PASSWORD:-admin}
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.grafana.rule=Host(`${DNS_NAME}`) && PathPrefix(`/grafana`)"
      - "traefik.http.routers.grafana.entrypoints=websecure"
{% if _jupyterhub_selfsigned | bool %}
      - "traefik.http.routers.grafana.tls=true"
{% else %}
      - "traefik.http.routers.grafana.tls.certresolver=myhttpchallenge"
{% endif %}
      - "traefik.http.routers.grafana.priority=100"
      - "traefik.http.services.grafana.loadbalancer.server.port=3000"
{% endif %}

volumes:
  letsencrypt:

networks:
  default:
    name: {{ jupyterhub_docker_network_name }}
